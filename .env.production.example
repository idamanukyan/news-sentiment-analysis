# AIIM Production Environment Configuration
# Copy this file to .env.production and fill in the values

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aiim_production
DB_USER=aiim_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===========================================
# Security Configuration
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_A_SECURE_64_CHAR_SECRET_KEY_FOR_PRODUCTION

# CORS origins (comma-separated)
CORS_ORIGINS=https://aiim.am,https://www.aiim.am

# ===========================================
# External APIs
# ===========================================
# Anthropic API key for sentiment analysis
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ===========================================
# Monitoring
# ===========================================
# Sentry DSN (optional)
SENTRY_DSN=

# Log level (INFO, DEBUG, WARN, ERROR)
LOG_LEVEL=INFO

# ===========================================
# Email Configuration (optional)
# ===========================================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@aiim.am

# ===========================================
# Application Settings
# ===========================================
# Server port
SERVER_PORT=8080

# Frontend URL
FRONTEND_URL=https://aiim.am

# Enable/disable demo mode
DEMO_MODE=false
