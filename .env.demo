# AIIM Demo Environment Configuration
# Copy to .env for demo deployments

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=newssentiment
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/newssentiment

# Backend
SPRING_PROFILES_ACTIVE=demo
JWT_SECRET=aiim-demo-secret-key-change-in-production-2025
JWT_EXPIRATION=86400000

# NewsAPI
NEWSAPI_KEY=your-newsapi-key-here

# Telegram (get from https://my.telegram.org)
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash
TELEGRAM_PHONE=your-phone-number

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend
VITE_API_URL=http://localhost:8080

# Demo Mode
DEMO_MODE=true
DEMO_USER_EMAIL=admin@aiim.am
DEMO_USER_PASSWORD=demo2025
