# AIIM Production Environment Configuration
# Copy to .env and fill in values before deployment

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aiim_production
DB_USER=aiim_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_POOL_SIZE=20
DB_POOL_MIN=5

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
JWT_EXPIRATION=86400000

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
LOG_PATH=/var/log/aiim

# CORS - Add your production domains
CORS_ORIGINS=https://aiim.am,https://www.aiim.am,https://app.aiim.am

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# Anthropic API for sentiment analysis
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# NewsAPI for news aggregation
NEWSAPI_KEY=CHANGE_ME

# Telegram API (from https://my.telegram.org)
TELEGRAM_API_ID=CHANGE_ME
TELEGRAM_API_HASH=CHANGE_ME
TELEGRAM_PHONE=+374XXXXXXXX

# ===========================================
# EMAIL CONFIGURATION (for alerts)
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=alerts@aiim.am
MAIL_PASSWORD=CHANGE_ME

# ===========================================
# MONITORING
# ===========================================
SENTRY_DSN=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=100

# ===========================================
# LANGFUSE LLM OBSERVABILITY
# ===========================================
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-5300e7c6-b6cc-46ad-b406-52e7dfa2203e
LANGFUSE_SECRET_KEY=sk-lf-dcd6f3bf-6f52-4205-a215-2d0876303e8f
LANGFUSE_HOST=https://cloud.langfuse.com

# ===========================================
# DOCKER CONFIGURATION
# ===========================================
DOCKER_REGISTRY=ghcr.io/your-org
VERSION=latest
COMPOSE_PROJECT_NAME=aiim

# ===========================================
# FRONTEND
# ===========================================
VITE_API_URL=https://api.aiim.am
VITE_APP_TITLE=AIIM - Armenia Information Integrity Monitor
