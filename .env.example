# AIIM Development Environment Configuration
# Copy this file to .env and customize as needed

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=newssentiment
DB_USER=postgres
DB_PASSWORD=postgres

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# Security Configuration
# ===========================================
# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=dev-secret-key-change-in-production-must-be-at-least-64-chars

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# External APIs
# ===========================================
# Anthropic API key for sentiment analysis (optional for dev)
ANTHROPIC_API_KEY=

# ===========================================
# Langfuse LLM Observability
# ===========================================
# Get your keys from https://cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===========================================
# Application Settings
# ===========================================
# Server port
SERVER_PORT=8080

# Log level
LOG_LEVEL=DEBUG

# Enable demo mode with sample data
DEMO_MODE=true

# ===========================================
# Docker Configuration
# ===========================================
DOCKER_REGISTRY=
VERSION=latest
